#!/usr/bin/env bash
# Entry point for Claude Code MCP registration.
#
# SAFE DEFAULT: drives the Xephyr sandbox on :1, NOT your real desktop.
# Go live by setting I3CUA_DISPLAY=:0 (e.g. register a second MCP entry with
#   -e I3CUA_DISPLAY=:0 -- ), once you trust it.
set -euo pipefail

HERE="$(cd "$(dirname "$0")/.." && pwd)"
export DISPLAY="${I3CUA_DISPLAY:-:1}"
exec uv run --directory "$HERE" hypr-cua-mcp
