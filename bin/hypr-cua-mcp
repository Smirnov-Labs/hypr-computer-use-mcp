#!/usr/bin/env bash
# Entry point for MCP clients (Claude Code, Codex, ...).
#
# With the shared per-login service running (contrib/systemd), this connects the
# client to it through a small stdlib connector. Otherwise it runs a stdio server
# for this session. Either way it DRIVES YOUR REAL DESKTOP. Supervise live runs.
set -euo pipefail

HERE="$(cd "$(dirname "$0")/.." && pwd)"
[ -x "$HERE/.venv/bin/python" ] || uv sync --directory "$HERE" --quiet
exec "$HERE/.venv/bin/python" -I -m hypr_cua_mcp.connect
